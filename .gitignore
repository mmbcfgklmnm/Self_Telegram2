# Session files — contain full account access, never commit these
*.session
*.session-journal

# Environment variables — contain secrets
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Editor and OS artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Temporary sticker files (created at runtime)
/tmp/
*.tgs.tmp
*.webm.tmp
*.webp.tmp

# Logs
*.log
logs/

# Coverage / testing
.coverage
htmlcov/
.pytest_cache/
