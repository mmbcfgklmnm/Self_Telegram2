# ──────────────────────────────────────────────
#  Required — Telegram API credentials
#  Get these from https://my.telegram.org/apps
# ──────────────────────────────────────────────
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ──────────────────────────────────────────────
#  Required — Pre-generated Telethon StringSession
#  Generate with: python generate_session.py
# ──────────────────────────────────────────────
SESSION_STRING=your_session_string_here

# ──────────────────────────────────────────────
#  Optional — Customise the trigger phrase
#  Default: "convert to sticker"
# ──────────────────────────────────────────────
TRIGGER_PHRASE=convert to sticker

# ──────────────────────────────────────────────
#  Optional — Logging verbosity
#  Values: DEBUG | INFO | WARNING | ERROR
#  Default: INFO
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
